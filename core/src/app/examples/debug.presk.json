            "action": "animate",
            "target" : "t01",
            "properties" : {
                "y" : "scene.bottomCenter.y"
            },
            "duration" : 5,
            "start" : "0"
        },{
            "action": "bind",
            "target" : "t02",
            "properties" : {
                "y" : "t01.y",
                "x" : "t01.topRight.x"
