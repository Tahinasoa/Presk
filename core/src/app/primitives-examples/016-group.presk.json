      "properties": { "x": 700, "y": 180, "width": 120, "height": 80, "fill": "#3b82f6", "stroke": "#ffffff", "strokeWidth": 2 }
    },
    {
      "action": "create",
      "target": "box2",
      "type": "rectangle",
      "properties": { "x": 900, "y": 280, "width": 120, "height": 80, "fill": "#10b981", "stroke": "#ffffff", "strokeWidth": 2 }
