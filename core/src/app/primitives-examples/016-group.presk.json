      "properties": { "x": 100, "y": 200, "text": "Item One", "fontSize": 24, "color": "#38bdf8", "fontFamily": "sans-serif" }
    },
    {
      "action": "create",
      "target": "txt2",
      "type": "text",
      "properties": { "x": 120, "y": 320, "text": "Item Two", "fontSize": 24, "color": "#38bdf8", "fontFamily": "sans-serif" }
    },
    {
      "action": "create",
      "target": "txt3",
      "type": "text",
      "properties": { "x": 80, "y": 450, "text": "Item Three", "fontSize": 24, "color": "#38bdf8", "fontFamily": "sans-serif" }
    },
    {
      "action": "animate",
      "target": "txt1",
      "properties": { "reveal": true },
      "duration": 0.4,
      "start": 0.2
    },
    {
      "action": "animate",
      "target": "txt2",
      "properties": { "reveal": true },
      "duration": 0.4,
      "start": "<"
