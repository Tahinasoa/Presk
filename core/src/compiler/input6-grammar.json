{
  "version": "0.1",
  "scene": {
    "width": 1920,
    "height": 1080,
    "background": "#080c14"
  },
  "steps": [
    { "action": "create", "target": "introTitle", "type": "text",
      "properties": { "text": "Analysons une phrase","pos":"scene.center", "scale": 1.3 } },
    {"action" : "transform", "target" :"introTitle", "properties" : {"y" : "50"},"duration" : 1, "start" : "+1"},
      
    { "action": "create", "target": "wordVerbe", "type": "text", "name": "verbeIn",
      "properties": { "text": "mange", "x": "wordSujet.right + 30", "y": "wordSujet.y", "scale": 1.1 },
      "start": "sujetIn+=0.3" },
    { "action": "create", "target": "wordCod", "type": "text", "name": "codIn",
      "properties": { "text": "une pomme", "x": "wordVerbe.right + 30", "y": "wordVerbe.y", "scale": 1.1 },
      "start": "verbeIn+=0.3" },

    { "action": "create", "target": "qBox", "type": "shape", "name": "qBoxIn",
      "properties": { "x": "scene.width / 2", "y": 700, "width": 760, "height": 100, "fill": 1779520, "stroke": 0, "strokeWidth": 0 },
      "start": "codIn+=0.6" },
    { "action": "create", "target": "qText", "type": "text", "name": "q1In",
      "properties": { "text": "Qui fait l'action ?", "x": "qBox.center.x", "y": "qBox.center.y", "scale": 1 }, "start": "<" },

    { "action": "destroy", "target": "qText", "start": "q1In+=1.5" },
    { "action": "create", "target": "underSujet", "type": "shape", "name": "underSujetIn",
      "properties": { "x": "wordSujet.center.x", "y": "wordSujet.center.y + 35", "width": "wordSujet.width", "height": 6, "fill": 5017087, "stroke": 0, "strokeWidth": 0 },
      "start": "<" },
    { "action": "follow", "target": "underSujet", "properties": { "x": "wordSujet.center.x", "y": "wordSujet.center.y + 35" }, "start": ">" },
    { "action": "create", "target": "labelSujet", "type": "text", "name": "labelSujetIn",
      "properties": { "text": "SUJET", "x": "wordSujet.center.x", "y": "wordSujet.center.y - 65", "scale": 0.8 },
      "start": "underSujetIn" },
    { "action": "follow", "target": "labelSujet", "properties": { "x": "wordSujet.center.x", "y": "wordSujet.center.y - 65" }, "start": ">" },

    { "action": "create", "target": "qText2", "type": "text", "name": "q2In",
      "properties": { "text": "Que fait-il ?", "x": "qBox.center.x", "y": "qBox.center.y", "scale": 1 }, "start": "labelSujetIn+=0.3" },

    { "action": "destroy", "target": "qText2", "start": "q2In+=1.5" },
    { "action": "create", "target": "underVerbe", "type": "shape", "name": "underVerbeIn",
      "properties": { "x": "wordVerbe.center.x", "y": "wordVerbe.center.y + 35", "width": "wordVerbe.width", "height": 6, "fill": 5036410, "stroke": 0, "strokeWidth": 0 },
      "start": "<" },
    { "action": "follow", "target": "underVerbe", "properties": { "x": "wordVerbe.center.x", "y": "wordVerbe.center.y + 35" }, "start": ">" },
    { "action": "create", "target": "labelVerbe", "type": "text", "name": "labelVerbeIn",
      "properties": { "text": "VERBE", "x": "wordVerbe.center.x", "y": "wordVerbe.center.y - 65", "scale": 0.8 },
      "start": "underVerbeIn" },
    { "action": "follow", "target": "labelVerbe", "properties": { "x": "wordVerbe.center.x", "y": "wordVerbe.center.y - 65" }, "start": ">" },

    { "action": "create", "target": "qText3", "type": "text", "name": "q3In",
      "properties": { "text": "Sur quoi porte l'action ?", "x": "qBox.center.x", "y": "qBox.center.y", "scale": 1 }, "start": "labelVerbeIn+=0.3" },

    { "action": "destroy", "target": "qText3", "start": "q3In+=1.5" },
    { "action": "create", "target": "underCod", "type": "shape", "name": "underCodIn",
      "properties": { "x": "wordCod.center.x", "y": "wordCod.center.y + 35", "width": "wordCod.width", "height": 6, "fill": 16739148, "stroke": 0, "strokeWidth": 0 },
      "start": "<" },
    { "action": "follow", "target": "underCod", "properties": { "x": "wordCod.center.x", "y": "wordCod.center.y + 35" }, "start": ">" },
    { "action": "create", "target": "labelCod", "type": "text", "name": "labelCodIn",
      "properties": { "text": "COD", "x": "wordCod.center.x", "y": "wordCod.center.y - 65", "scale": 0.8 },
      "start": "underCodIn" },
    { "action": "follow", "target": "labelCod", "properties": { "x": "wordCod.center.x", "y": "wordCod.center.y - 65" }, "start": ">" },

    { "action": "transform", "target": "qBox", "name": "qBoxFade",
      "properties": { "opacity": 0 }, "start": "labelCodIn+=1.2", "duration": 0.4 },
    { "action": "destroy", "target": "qBox", "start": "qBoxFade+=0.4" },

    { "action": "transform", "target": "wordSujet", "name": "moveUpSujet",
      "properties": { "y": 260 }, "start": "qBoxFade+=0.4", "duration": 1.0, "ease": "power2.inOut" },
    { "action": "transform", "target": "wordVerbe", "properties": { "y": 260 }, "start": "<", "duration": 1.0, "ease": "power2.inOut" },
    { "action": "transform", "target": "wordCod", "properties": { "y": 260 }, "start": "<", "duration": 1.0, "ease": "power2.inOut" },

    { "action": "create", "target": "passiveIntro", "type": "text", "name": "passIntroIn",
      "properties": { "text": "Et à la voix passive ?", "x": "scene.width / 2", "y": 480, "scale": 1.1 },
      "start": "moveUpSujet+=1.2" },
    { "action": "transform", "target": "passiveIntro", "name": "passIntroOut",
      "properties": { "opacity": 0, "scale": 0.8 }, "start": "passIntroIn+=1.6", "duration": 0.5 },
    { "action": "destroy", "target": "passiveIntro", "start": "passIntroOut+=0.5" },

    { "action": "create", "target": "pWordCod", "type": "text", "name": "pCodIn",
      "properties": { "text": "Une pomme", "x": "scene.width * 0.2", "y": 760, "scale": 1.1 },
      "start": "passIntroOut" },
    { "action": "create", "target": "pWordVerbe", "type": "text", "name": "pVerbeIn",
      "properties": { "text": "est mangée", "x": "pWordCod.topRight.x + 30", "y": "pWordCod.y", "scale": 1.1 },
      "start": "pCodIn+=0.3" },
    { "action": "create", "target": "pWordSujet", "type": "text", "name": "pSujetIn",
      "properties": { "text": "par le petit garçon", "x": "pWordVerbe.topRight.x + 30", "y": "pWordVerbe.y", "scale": 1.1 },
      "start": "pVerbeIn+=0.3" },

    { "action": "create", "target": "mapCod", "type": "line",
      "properties": { "x": 0, "y": 0, "startX": "wordCod.center.x", "startY": "wordCod.bottomLeft.y", "endX": "wordCod.center.x", "endY": "wordCod.bottomLeft.y", "stroke": 5017087, "thickness": 3 },
      "start": "pSujetIn+=0.5" },
    { "action": "follow", "target": "mapCod", "properties": { "startX": "wordCod.center.x", "startY": "wordCod.bottomLeft.y" }, "start": "<" },
    { "action": "transform", "target": "mapCod", "name": "mapCodDraw",
      "properties": { "endX": "pWordCod.center.x", "endY": "pWordCod.topLeft.y" }, "start": "<", "duration": 0.8, "ease": "power2.inOut" },
    { "action": "create", "target": "labelPSujet", "type": "text",
      "properties": { "text": "SUJET", "x": "pWordCod.center.x", "y": "pWordCod.center.y + 55", "scale": 0.8, "opacity": 0 },
      "start": "mapCodDraw+=0.8" },
    { "action": "transform", "target": "labelPSujet", "properties": { "opacity": 1 }, "start": "<", "duration": 0.3 },
    { "action": "follow", "target": "labelPSujet", "properties": { "x": "pWordCod.center.x", "y": "pWordCod.center.y + 55" }, "start": ">" },

    { "action": "create", "target": "mapVerbe", "type": "line",
      "properties": { "x": 0, "y": 0, "startX": "wordVerbe.center.x", "startY": "wordVerbe.bottomLeft.y", "endX": "wordVerbe.center.x", "endY": "wordVerbe.bottomLeft.y", "stroke": 5036410, "thickness": 3 },
      "start": "mapCodDraw+=1.1" },
    { "action": "follow", "target": "mapVerbe", "properties": { "startX": "wordVerbe.center.x", "startY": "wordVerbe.bottomLeft.y" }, "start": "<" },
    { "action": "transform", "target": "mapVerbe", "name": "mapVerbeDraw",
      "properties": { "endX": "pWordVerbe.center.x", "endY": "pWordVerbe.topLeft.y" }, "start": "<", "duration": 0.8, "ease": "power2.inOut" },
    { "action": "create", "target": "labelPVerbe", "type": "text",
      "properties": { "text": "VERBE", "x": "pWordVerbe.center.x", "y": "pWordVerbe.center.y + 55", "scale": 0.8, "opacity": 0 },
      "start": "mapVerbeDraw+=0.8" },
    { "action": "transform", "target": "labelPVerbe", "properties": { "opacity": 1 }, "start": "<", "duration": 0.3 },
    { "action": "follow", "target": "labelPVerbe", "properties": { "x": "pWordVerbe.center.x", "y": "pWordVerbe.center.y + 55" }, "start": ">" },

    { "action": "create", "target": "mapSujet", "type": "line",
      "properties": { "x": 0, "y": 0, "startX": "wordSujet.center.x", "startY": "wordSujet.bottomLeft.y", "endX": "wordSujet.center.x", "endY": "wordSujet.bottomLeft.y", "stroke": 10185727, "thickness": 3 },
      "start": "mapVerbeDraw+=1.1" },
    { "action": "follow", "target": "mapSujet", "properties": { "startX": "wordSujet.center.x", "startY": "wordSujet.bottomLeft.y" }, "start": "<" },
    { "action": "transform", "target": "mapSujet", "name": "mapSujetDraw",
      "properties": { "endX": "pWordSujet.center.x", "endY": "pWordSujet.topLeft.y" }, "start": "<", "duration": 0.8, "ease": "power2.inOut" },
    { "action": "create", "target": "labelPCompl", "type": "text",
      "properties": { "text": "COMPLÉMENT D'AGENT", "x": "pWordSujet.center.x", "y": "pWordSujet.center.y + 55", "scale": 0.7, "opacity": 0 },
      "start": "mapSujetDraw+=0.8" },
    { "action": "transform", "target": "labelPCompl", "properties": { "opacity": 1 }, "start": "<", "duration": 0.3 },
    { "action": "follow", "target": "labelPCompl", "properties": { "x": "pWordSujet.center.x", "y": "pWordSujet.center.y + 55" }, "start": ">" },

    { "action": "create", "target": "conclusion", "type": "text",
      "properties": { "text": "À la voix passive, le COD devient sujet.", "x": "scene.width / 2", "y": "scene.height * 0.92", "scale": 0.9, "opacity": 0 },
      "start": "mapSujetDraw+=1.6" },
    { "action": "transform", "target": "conclusion", "name": "conclusionShow",
      "properties": { "opacity": 1 }, "start": "<", "duration": 0.6 },
    { "action": "transform", "target": "conclusion", "name": "conclusionHide",
      "properties": { "opacity": 0 }, "start": "conclusionShow+=2.5", "duration": 0.6 },
    { "action": "destroy", "target": "conclusion", "start": "conclusionHide+=0.6" }
  ]
}
