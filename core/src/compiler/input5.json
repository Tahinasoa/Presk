      "target": "cometLabel",
      "start": "cometFly+=2.2"
    },
    {
      "action": "destroy",
      "target": "comet",
      "start": "<"
    },
    {
      "action": "unfollow",
      "target": "earthLabel",
      "properties": [
        "x",
        "y"
      ],
      "start": "beltLabelHide+=7.0"
    },
    {
      "action": "transform",
      "target": "earthLabel",
      "name": "earthCallout",
      "properties": {
        "x": "scene.width * 0.5",
        "y": "scene.height * 0.12",
        "scale": 1.3,
        "opacity": 1
      },
      "start": "<",
      "duration": 0.7,
      "ease": "back.out(1.4)"
    },
    {
      "action": "transform",
      "target": "earthLabel",
      "name": "earthCalloutOut",
      "properties": {
        "opacity": 0
      },
      "start": "earthCallout+=1.6",
      "duration": 0.5
    },
    {
      "action": "create",
      "target": "titleOutro",
      "type": "text",
      "properties": {
        "text": "Un ballet céleste depuis 4,5 milliards d'années",
        "x": "scene.width / 2",
        "y": "scene.height * 0.5",
        "scale": 0
      },
      "start": "earthCalloutOut+=1.0"
    },
    {
      "action": "transform",
      "target": "titleOutro",
      "name": "outroShow",
      "properties": {
        "scale": 1
      },
      "start": "<",
      "duration": 0.8,
      "ease": "back.out(1.5)"
    },
    {
      "action": "transform",
      "target": "titleOutro",
      "name": "outroHide",
      "properties": {
        "opacity": 0,
        "scale": 0.8
      },
      "start": "outroShow+=2.5",
      "duration": 0.6
    },
    {
      "action": "destroy",
      "target": "titleOutro",
      "start": "outroHide+=0.6"
    }
  ]
}