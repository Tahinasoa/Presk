{
  "name": "@presk/core",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tahinasoa/Presk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "description": "Presk engine: DSL compiler, binding engine, and PixiJS renderer.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json --outDir dist/types && tsc-alias -p tsconfig.build.json --outDir dist/types",
    "prepublishOnly": "pnpm build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pixi.js": "^8.21.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@presk/core": "workspace:*",
    "nanoid": "^6.0.1",
    "transformation-matrix": "^3.1.0"
  },
  "peerDependencies": {
    "pixi.js": "^8.21.0"
  },
  "license": "MIT"
}